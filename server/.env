DEMO_MODE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Database Configuration
# SQLite (default for development)
DATABASE_URL=sqlite+aiosqlite:///./mausammitra.db
# PostgreSQL connection string (for production)
# Format: postgresql+asyncpg://username:password@host:port/database_name
# DATABASE_URL=postgresql+asyncpg://mausammitra:password@localhost:5432/mausammitra

# External API Keys (for future integration)
# OPENWEATHER_API_KEY=your_openweather_api_key
# IMD_API_KEY=your_imd_api_key
